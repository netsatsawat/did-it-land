{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://effectkit.dev/schema/capsule.schema.json",
  "title": "effectkit capsule",
  "description": "One external operation, with the knowledge needed to answer 'did it land' and 'how do I reverse it'. See docs/CAPSULE-SCHEMA.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "provider", "operation", "schema_version", "idempotency", "probe", "reversibility"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$",
      "description": "provider.operation, for example stripe.charge"
    },
    "provider": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": { "enum": ["client_key", "natural_key", "none"] },
        "header": { "type": "string", "description": "header carrying the client key, for client_key" },
        "keys": {
          "type": "array",
          "items": { "type": "string" },
          "description": "context fields forming the natural key, for natural_key"
        },
        "notes": { "type": "string" }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["http", "native"] },
        "handler": { "type": "string", "description": "native handler id, for kind native" },
        "request": { "$ref": "#/$defs/request" },
        "interpret": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rule" },
          "description": "ordered rules; first match wins, default is unknown"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "http" } } },
          "then": { "required": ["request", "interpret"] }
        },
        {
          "if": { "properties": { "kind": { "const": "native" } } },
          "then": { "required": ["handler"] }
        }
      ]
    },
    "reversibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "properties": {
        "class": { "enum": ["reversible", "conditionally_reversible", "irreversible"] },
        "condition": {
          "type": "string",
          "description": "the precondition under which a conditionally_reversible op can be undone"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "class": { "const": "conditionally_reversible" } } },
          "then": { "required": ["condition"] }
        }
      ]
    },
    "compensation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["http", "native", "none"] },
        "handler": { "type": "string" },
        "request": { "$ref": "#/$defs/request" },
        "notes": { "type": "string" }
      }
    },
    "notes": { "type": "string" },
    "source": { "type": "string", "description": "doc URL the capsule was derived from" }
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"] },
        "path": {
          "type": "string",
          "description": "URL path template; {name} placeholders are bound from the call context"
        },
        "query": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "query params; values may contain {name} placeholders"
        },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result"],
      "properties": {
        "when": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status_in": {
              "type": "array",
              "items": { "type": "integer" }
            },
            "json_path": {
              "type": "string",
              "description": "dotted path into the JSON body, for example data.0.id"
            },
            "exists": { "type": "boolean" },
            "equals": {},
            "count_gte": { "type": "integer" }
          }
        },
        "result": { "enum": ["landed", "not_landed", "unknown"] }
      }
    }
  }
}
