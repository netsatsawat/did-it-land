{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/netsatsawat/did-it-land/blob/main/schema/capsule.schema.json",
  "title": "did-it-land capsule",
  "description": "One external operation, with the knowledge needed to answer 'did it land' and 'how do I reverse it'. See docs/CAPSULE-SCHEMA.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "provider", "operation", "schema_version", "idempotency", "probe", "reversibility"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$",
      "description": "provider.operation, for example stripe.charge"
    },
    "provider": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1", "description": "the capsule format version this schema and both runtimes read" },
    "summary": { "type": "string" },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": { "enum": ["client_key", "natural_key", "none"] },
        "header": { "type": "string", "description": "header carrying the client key, for client_key" },
        "keys": {
          "type": "array",
          "items": { "type": "string" },
          "description": "context fields forming the natural key, for natural_key"
        },
        "notes": { "type": "string" }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["http", "native"] },
        "handler": { "type": "string", "description": "native handler id, for kind native" },
        "request": { "$ref": "#/$defs/request" },
        "interpret": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rule" },
          "description": "ordered rules; first match wins, default is unknown"
        },
        "confirm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["request", "interpret"],
          "properties": {
            "request": { "$ref": "#/$defs/request" },
            "interpret": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/rule" }
            },
            "notes": { "type": "string" }
          },
          "description": "second, lag-free question asked only when the primary probe answers not_landed; its verdict wins. Closes read-after-write gaps such as search indexing lag."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "http" } } },
          "then": { "required": ["request", "interpret"] }
        },
        {
          "if": { "properties": { "kind": { "const": "native" } } },
          "then": { "required": ["handler"] }
        }
      ]
    },
    "reversibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "properties": {
        "class": { "enum": ["reversible", "conditionally_reversible", "irreversible"] },
        "condition": {
          "type": "string",
          "description": "the precondition under which a conditionally_reversible op can be undone"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "class": { "const": "conditionally_reversible" } } },
          "then": { "required": ["condition"] }
        }
      ]
    },
    "compensation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["http", "native", "none"] },
        "handler": { "type": "string" },
        "request": { "$ref": "#/$defs/request" },
        "notes": { "type": "string" }
      }
    },
    "notes": { "type": "string" },
    "source": {
      "description": "doc URL(s) the capsule was derived from",
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      ]
    }
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"] },
        "path": {
          "type": "string",
          "description": "URL path template; {name} placeholders are bound from the call context"
        },
        "query": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "query params; values may contain {name} placeholders"
        },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result"],
      "properties": {
        "when": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status_in": {
              "type": "array",
              "items": { "type": "integer" }
            },
            "json_path": {
              "type": "string",
              "description": "dotted path into the JSON body, for example data.0.id"
            },
            "exists": { "type": "boolean" },
            "equals": {},
            "count_gte": { "type": "integer" },
            "where": {
              "type": "object",
              "additionalProperties": {},
              "description": "when the json_path target is an array, keep only elements whose fields equal these values before applying count_gte; keys may be dotted paths into each element, for example metadata.order_id"
            }
          }
        },
        "result": { "enum": ["landed", "not_landed", "unknown"] }
      }
    }
  }
}
